{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "redirects": [
    { "source": "/group-up", "destination": "/dungeon-planner", "permanent": true },
    { "source": "/simulations", "destination": "/roster", "permanent": true },
    { "source": "/tier-prep", "destination": "/dungeon-planner", "permanent": true }
  ],
  "rewrites": [
    { "source": "/roster", "destination": "/index.html" },
    { "source": "/dungeon-planner", "destination": "/index.html" },
    { "source": "/character/:slug", "destination": "/index.html" },
    { "source": "/character/:slug/progress", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
